{
	"name": "svelte-collab",
	"version": "0.0.1",
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:integration": "vitest tests/integration",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test": "npm run test:unit -- --run && npm run test:integration -- --run",
		"test:all": "npm run test:unit -- --run && npm run test:integration -- --run && npm run test:e2e",
		"server": "tsx server/websocket.ts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"biome": "biome check --write .",
		"biome:check": "biome check ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/ws": "^8.18.1",
		"@vitest/browser": "^4.0.3",
		"@vitest/browser-playwright": "^4.0.3",
		"playwright": "^1.55.1",
		"publint": "^0.3.13",
		"svelte": "^5.41.4",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^4.0.3",
		"vitest-browser-svelte": "^2.0.0",
		"ws": "^8.18.3"
	},
	"description": "Reactive real-time collaboration primitives for Svelte - powered by Y.js CRDTs",
	"license": "MIT",
	"keywords": [
		"svelte",
		"collaboration",
		"crdt",
		"yjs",
		"realtime",
		"websocket",
		"collaborative-editing",
		"presence",
		"sync"
	],
	"dependencies": {
		"lib0": "^0.2.114",
		"y-indexeddb": "^9.0.12",
		"y-protocols": "^1.0.6",
		"y-websocket": "^3.0.0",
		"yjs": "^13.6.27"
	}
}
